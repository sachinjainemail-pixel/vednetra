# Copy this file to .env and fill in your own values. Never commit .env.

# From https://developers.kite.trade (your Kite Connect app)
KITE_API_KEY=
KITE_API_SECRET=

# Filled in automatically by `npm run login` (see src/login.js).
# Access tokens expire daily around market close/next login window -
# rerun `npm run login` each trading day before running the backtest.
KITE_ACCESS_TOKEN=

# --- Backtest configuration ---

# Number of trailing trading days to attempt to backtest.
# NOTE: Kite's historical API only reliably serves data for option contracts
# still present in the current instruments dump (roughly the current week
# and maybe 1-2 recently expired weeks). Older weeks will be skipped and
# reported as unavailable, not silently dropped.
BACKTEST_TRADING_DAYS=30

# Quantity per leg, in lots (multiplied by each contract's exchange lot size).
BACKTEST_LOTS=1

# Optional flat cost (brokerage + STT + slippage estimate) charged per trade,
# in rupees per lot, deducted from gross P&L to get net P&L. Set to 0 to see
# pure price-based P&L with no cost assumptions.
BACKTEST_COST_PER_TRADE_PER_LOT=40
